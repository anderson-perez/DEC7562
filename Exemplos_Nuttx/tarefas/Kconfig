#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config TAREFAS
	tristate "Exemplo threads e tarefas"
	default n
	---help---
		Este exemplo ilustra o uso de pthreads e tasks no Nuttx

if TAREFAS

config TAREFAS_PROGNAME
	string "Nome do programa"
	default "tarefas"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config TAREFAS_PRIORITY
	int "Prioridade"
	default 100

config TAREFAS_STACKSIZE
	int "Tamanho da pilha"
	default DEFAULT_TASK_STACKSIZE

endif
